FROM eclipse-temurin:21-jre-alpine

ENV MAX_RAM_PERCENTAGE=75

RUN addgroup -g 1000 so && adduser -S -u 1000 -G so -s /bin/sh so

ARG http_proxy
ENV HTTP_PROXY=$http_proxy
ENV http_proxy=$HTTP_PROXY
ARG https_proxy
ENV HTTPS_PROXY=$https_proxy
ENV https_proxy=$HTTPS_PROXY
ARG HELM_VERSION=v3.22.1

RUN mkdir -p /app/config /app/logs /app/csar /app/kube-configs

# This can basically always be the latest version
ARG OTEL_AGENT_VERSION=2.26.1
RUN wget -O /app/opentelemetry-javaagent.jar \
    https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_AGENT_VERSION}/opentelemetry-javaagent.jar

COPY maven/app.jar /app
COPY configs/logging/logback-spring.xml /app
COPY scripts/start-app.sh /app
RUN chown -R so:so /app

ARG TAR_FILE="helm-${HELM_VERSION}-linux-amd64.tar.gz"

RUN wget -q https://get.helm.sh/${TAR_FILE} https://get.helm.sh/${TAR_FILE}.sha256sum && \
    sha256sum -c ${TAR_FILE}.sha256sum && \
    tar xf ${TAR_FILE} && \
    chmod +x linux-amd64/helm && \
    mv linux-amd64/helm /usr/local/bin && \
    rm -rf linux-amd64 ${TAR_FILE} ${TAR_FILE}.sha256sum

USER so

# Springboot configuration (required)
VOLUME /app/config

WORKDIR /app
ENTRYPOINT ["/app/start-app.sh"]
